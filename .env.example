# Copy this file to profiles/<customer>/.env and fill in real values.
# Never commit a .env file with real credentials.

# Teradata ODS (Source)
KPN_TERADATA_HOST=your_teradata_host_here
KPN_TERADATA_USER=your_teradata_user_here
KPN_TERADATA_PASS=your_teradata_password_here
KPN_TERADATA_DB=ODS_SCHEMA

# Microsoft Fabric ODS (Target)
KPN_FABRIC_SERVER=yourworkspace.datawarehouse.fabric.microsoft.com
KPN_FABRIC_DB=ODS_FABRIC
KPN_FABRIC_USER=your_fabric_user_here
KPN_FABRIC_PASS=your_fabric_password_here
# AUTH options: ActiveDirectoryPassword | SqlPassword | ActiveDirectoryServicePrincipal
KPN_FABRIC_AUTH=ActiveDirectoryPassword
